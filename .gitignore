# Encrypted sensitive data - NEVER commit
backend/.credentials
backend/.credentials.enc
# store-card.js is the tool that WRITES .credentials.enc — it holds no secrets
# itself. Ignoring it meant it was never committed, so it did not survive the
# move to Unraid and refillAccount() spent months pointing at a script that
# had never existed on the server. Keep it tracked.
*.enc
*.key

# Uploaded files (user content)
backend/uploads/
backups/

# Local tooling
.claude/

# Windows reserved-name artifact (created by mis-redirected commands)
nul

# Accidental nested clone — must never be committed (held live secrets)
/WorxTech/
